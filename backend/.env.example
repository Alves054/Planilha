PORT=3001
DATABASE_URL="file:./dev.db"

# Pace AI & Importação de Imagem — Configurações da OpenAI API
# IMPORTANTE: Para importar imagens de planilhas, o modelo DEVE ser gpt-4o ou gpt-4o-mini com suporte Vision.
# gpt-4o-mini suporta Vision mas tem menor precisão. Use gpt-4o para melhor resultado.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
AI_MAX_CONTEXT_LENGTH=1000
AI_MAX_MESSAGE_LENGTH=2000

# Modos da Integração Garmin: "production" (API Oficial) ou "mock" (Simulação Local)
GARMIN_MODE=production

# Credenciais Oficiais do Garmin Connect Developer Program (Obtidas em developer.garmin.com)
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=http://localhost:3001/api/garmin/callback

# URLs da API Garmin (Conforme fornecido no Portal Garmin Developer para seu aplicativo)
GARMIN_API_BASE_URL=https://connectapi.garmin.com
GARMIN_AUTH_BASE_URL=https://connect.garmin.com

# Configuração de Fuso Horário Padrão
DEFAULT_TIMEZONE=America/Sao_Paulo
