generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String
  weeks             Week[]
  garminConnections GarminConnection[]
  syncLogs          SyncLog[]
  pdfImports        PDFImport[]
  templates         WorkoutTemplate[]
  aiConversations   AIConversation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Week {
  id                String           @id @default(uuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String?
  startDate         String           // YYYY-MM-DD
  endDate           String           // YYYY-MM-DD
  plannedVolumeKm   Float            @default(0)
  originalPdfVolume String?          // ex: "≈ 90 km"
  status            String           @default("EM_ANDAMENTO") // RASCUNHO, EM_ANDAMENTO, CONCLUIDO
  trainingDays      TrainingDay[]
  pdfImports        PDFImport[]
  aiConversations   AIConversation[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model TrainingDay {
  id        String    @id @default(uuid())
  weekId    String
  week      Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  date      String    // YYYY-MM-DD
  dayOfWeek String    // SEGUNDA, TERCA, QUARTA, QUINTA, SEXTA, SABADO, DOMINGO
  isRestDay Boolean   @default(false)
  notes     String?
  workouts  Workout[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Workout {
  id                   String        @id @default(uuid())
  trainingDayId        String
  trainingDay          TrainingDay   @relation(fields: [trainingDayId], references: [id], onDelete: Cascade)
  time                 String?       // ex: "07:00" ou "Manhã" / "Tarde"
  period               String        @default("MANHA") // MANHA, TARDE, NOITE
  sport                String        @default("RUNNING") // RUNNING, STRENGTH, REST
  category             String        @default("LEVE") // LEVE, REGENERATIVO, TIROS, FARTLEK, CONTROLADO, LONGAO, HALTERES, DESCANSO
  name                 String
  targetDistanceKm     Float?
  estimatedDistanceKm  Float?
  targetPaceMin        String?       // ex: "4:40"
  targetPaceMax        String?       // ex: "5:10"
  targetHeartRateZone  String?
  repeatCount          Int           @default(1)
  notes                String?
  syncStatus           String        @default("RASCUNHO") // RASCUNHO, CONFIRMADO, PRONTO_PARA_SINCRONIZAR, ENVIANDO, SINCRONIZADO, ERRO
  garminWorkoutId      String?
  syncHash             String?       // Hash para controle de alteração pós-sincronização
  lastSyncedAt         DateTime?
  syncError            String?
  steps                WorkoutStep[]
  syncLogs             SyncLog[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model WorkoutStep {
  id            String   @id @default(uuid())
  workoutId     String
  workout       Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  stepOrder     Int
  stepType      String   // WARMUP, RUN, RECOVERY, COOL_DOWN, REST
  durationType  String   // TIME (segundos), DISTANCE (metros)
  durationValue Float    // valor numerico em segundos ou metros
  targetType    String?  // PACE, HR_ZONE, OPEN
  targetMin     String?
  targetMax     String?
  notes         String?
  createdAt     DateTime @default(now())
}

model GarminConnection {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  connected    Boolean   @default(false)
  accountName  String?
  garminUserId String?
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  mode         String    @default("production") // "production" | "mock"
  connectedAt  DateTime?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PDFImport {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekId         String?
  week           Week?    @relation(fields: [weekId], references: [id], onDelete: SetNull)
  filename       String
  totalParsed    Int      @default(0)
  totalPersisted Int      @default(0)
  status         String   @default("SUCCESS") // SUCCESS, FAILED
  error          String?
  createdAt      DateTime @default(now())
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekId    String?
  week      Week?       @relation(fields: [weekId], references: [id], onDelete: SetNull)
  title     String      @default("Nova Conversa")
  messages  AIMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // user | assistant | system
  content        String
  createdAt      DateTime       @default(now())
}

model SyncLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId String?
  workout   Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  provider  String   @default("GARMIN_CONNECT")
  action    String
  status    String   // SUCCESS, FAILED, PENDING
  message   String
  error     String?
  response  String?
  payload   String?  // JSON string
  createdAt DateTime @default(now())
}

model WorkoutTemplate {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  category    String
  description String?
  workoutData String   // JSON string
  createdAt   DateTime @default(now())
}
