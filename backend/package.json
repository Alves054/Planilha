{
  "name": "pace-training-backend",
  "version": "1.0.0",
  "description": "Backend API para o Pace Training",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "npx prisma generate && npx prisma db push --accept-data-loss && node dist/server.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "test:garmin": "tsx src/tests/garminAudit.test.ts",
    "test:pdf": "tsx src/tests/pdfImport.test.ts",
    "test:ai": "tsx src/tests/aiChat.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/multer": "^2.3.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.4.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.5",
    "@types/pdf-parse": "^1.1.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
